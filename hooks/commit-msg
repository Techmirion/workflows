#!/usr/bin/env python3
# techmirion-hook: commit-msg (Techmirion/workflows, git.md 5)
"""Check the commit message: `type(place): message (#N)`.

- On a `type/N-topic` branch, adds `(#N)` if the subject still has no
  reference (the case where the subject was written in the editor).
- Refuses a subject that does not match the format, and a message that uses a
  closing keyword (`Fixes #N`): a commit does not finish an issue, the release does.
- Exempt: merge and revert commits. fixup!/squash! commits pass here (they are
  squashed before review); CI warns if one reaches a PR.
"""
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [HERE, os.path.join(HERE, "..", "scripts")]

from tmflow import fmt  # noqa: E402


def git(*args):
    p = subprocess.run(["git", *args], capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 else None


def comment_char():
    c = git("config", "core.commentChar")
    return c if c and c != "auto" else "#"


def main(argv):
    if len(argv) < 2:
        return 0
    path = argv[1]
    gd = git("rev-parse", "--git-dir") or ".git"
    if os.path.exists(os.path.join(gd, "MERGE_HEAD")):
        return 0
    cc = comment_char()
    with open(path, encoding="utf-8") as f:
        text = f.read()
    subject = fmt.subject_of(text, cc)
    if not subject:
        return 0  # git aborts an empty message by itself
    issue = fmt.issue_from_branch(git("symbolic-ref", "--quiet", "--short", "HEAD") or "")
    if issue is not None and not os.path.exists(os.path.join(gd, "rebase-merge")):
        new = fmt.add_ref_to_message(text, issue, cc)
        if new != text:
            with open(path, "w", encoding="utf-8") as f:
                f.write(new)
            text, subject = new, fmt.subject_of(new, cc)
    problems = fmt.check_subject(subject, allow_autosquash=True)
    if not fmt.subject_exempt(subject):
        body = "\n".join(fmt.message_lines(text, cc))
        refs = fmt.closing_refs(body)
        if refs:
            problems.append(
                f"the message closes {', '.join(refs)}: commits do not use Fixes/Closes "
                "(git.md 5); put `Fixes #N` in the PR body instead"
            )
    if not problems:
        return 0
    sys.stderr.write("commit refused by the Techmirion commit-msg hook:\n")
    for p in problems:
        sys.stderr.write(f"  - {p}\n")
    sys.stderr.write(
        "  format: type(place): message (#N), type one of " + ", ".join(fmt.TYPES) + "\n"
        "  example: fix(auth): redirect after login (#34)\n"
        "  your message is kept in .git/COMMIT_EDITMSG; edit it with: git commit -e -F .git/COMMIT_EDITMSG\n"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
